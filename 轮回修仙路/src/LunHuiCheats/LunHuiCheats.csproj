<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>LunHuiCheats</AssemblyName>
    <RootNamespace>LunHuiCheats</RootNamespace>
    <Version>0.0.1</Version>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="6.0.0-be.755" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.755" />
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.5.1-ci.829" />
    <PackageReference Include="HarmonyX" Version="2.10.2" />
    <PackageReference Include="UnityEngine.Modules" Version="2020.3.49" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <!-- IL2CPP proxy assemblies are generated by BepInEx under interop/ after first launch -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameRoot)\BepInEx\interop\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameRoot)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
