<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="HarmonyX" Version="2.10.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LordsAndVilleinsCheats\LordsAndVilleinsCheats.csproj" />
  </ItemGroup>
  <!-- Re-enable copy-local for Harmony and BepInEx DLLs stripped by BepInEx.Core.targets in the mod project.
       The test host (net8.0) needs these DLLs present at runtime. -->
  <Target Name="RestoreTestRuntimeRefs" AfterTargets="SkipBepinRefs">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(ReferencePath)"
        Condition="'%(ReferencePath.NuGetPackageId)' == 'HarmonyX' OR
                   '%(ReferencePath.NuGetPackageId)' == 'MonoMod.RuntimeDetour' OR
                   '%(ReferencePath.NuGetPackageId)' == 'MonoMod.Utils' OR
                   '%(ReferencePath.NuGetPackageId)' == 'Mono.Cecil'" />
    </ItemGroup>
  </Target>
</Project>
